# Copy this file to .env and fill in values for your environment.
# Frontend variables must be prefixed with VITE_ to be exposed to the browser.

# URL of the Express backend (must match PORT below)
VITE_API_URL=http://localhost:3001

# Port the backend server listens on
PORT=3001

# Allowed CORS origin (your Vite dev server)
ALLOWED_ORIGIN=http://localhost:5173

# Shared token used by the frontend and backend for local development.
# Use a long random value in real deployments.
TREE_API_TOKEN=replace-with-a-local-dev-token
VITE_API_TOKEN=replace-with-a-local-dev-token

# Only set this to true for short-lived local experiments.
ALLOW_UNAUTHENTICATED_API=false
